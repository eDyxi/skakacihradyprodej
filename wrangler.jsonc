{
  "name": "skakacihradyprodej",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  // rate limit API podle IP: formulář 5/min, AI chat 20/min
  "ratelimits": [
    { "name": "RL_FORM", "namespace_id": "71001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "71002", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" }
}
